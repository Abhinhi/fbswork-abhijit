	            System.out.println("Node added successfully");

	            return;
	        }

	        temp.next = start;
	        start.prev = temp;
	        start = temp;

	        System.out.println("Node added successfully");
	    }

	    // insert at end
	    public void insertAtEnd(int data) {

	        Node temp = new Node(data);

	        if (start == null) {

	            start = temp;

	            System.out.println("Node added successfully");

	            return;
	        }

	        Node ptr = start;

	        while (ptr.next != null) {

	            ptr = ptr.next;
	        }

	        ptr.next = temp;
	        temp.prev = ptr;

	        System.out.println("Node added at end");
	    }
	    
