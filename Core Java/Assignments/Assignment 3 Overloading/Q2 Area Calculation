class Triangle{

    double base,height;

    Triangle(double base,double height){
        this.base=base;
        this.height=height;
    }
}

class Rectangle{

    double length,breadth;

    Rectangle(double length,double breadth){
        this.length=length;
        this.breadth=breadth;
    }
}

class Circle{

    double radius;

    Circle(double radius){
        this.radius=radius;
    }
}

class Shape{

    void calculateArea(Triangle t){
        double area=0.5*t.base*t.height;
        System.out.println("Area of Triangle is "+area);
    }

    void calculateArea(Rectangle r){
        double area=r.length*r.breadth;
        System.out.println("Area of Rectangle is "+area);
    }

    void calculateArea(Circle c){
        double area=3.14*c.radius*c.radius;
        System.out.println("Area of Circle is "+area);
    }
}

class CheckShape{

    public static void main(String[] args){

        Shape s1;
        s1=new Shape();

        Triangle t1;
        t1=new Triangle(10,5);

        Rectangle r1;
        r1=new Rectangle(8,4);

        Circle c1;
        c1=new Circle(7);

        s1.calculateArea(t1);
        s1.calculateArea(r1);
        s1.calculateArea(c1);
    }
}
